# Copy this file to .env and fill in your keys.

# --- Cloud models (OPTIONAL — leave blank to run only your free local Qwen models) ---
# If you ever want them:  one OpenRouter key (openrouter.ai/keys) runs BOTH GPT-5.6 Sol and Claude Opus 5.5.
OPENROUTER_API_KEY=
OPENROUTER_GPT_MODEL=openai/gpt-5.6-sol
OPENROUTER_OPUS_MODEL=anthropic/claude-opus-5.5

# Opus spending controls (it plans, reviews and answers @opus; local models do the rest)
# Monthly limit in dollars. Optional daily limit too (leave blank for none).
OPUS_MONTHLY_BUDGET=10.00
OPUS_DAILY_BUDGET=
OPUS_MAX_TOKENS=1500

# Optional: direct keys. If set, they're used instead of OpenRouter for that model.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model IDs (change these if a name changes or you want a different tier)
# GPT-5.6 tiers: gpt-5.6-sol (flagship), gpt-5.6-terra (balanced), gpt-5.6-luna (fast/cheap)
OPENAI_MODEL=gpt-5.6-sol
ANTHROPIC_MODEL=claude-opus-5-5

# --- Local models (Ollama) ---
OLLAMA_URL=http://127.0.0.1:11434
GEMMA_MODEL=gemma4:12b
QWEN_CODER_MODEL=qwen3-coder:30b
# How much conversation the local models can "see" at once (tokens). Lower it if you run out of GPU memory.
OLLAMA_NUM_CTX=16384

# --- Server ---
PORT=3000
HOST=0.0.0.0
# Strongly recommended: anyone who can reach this port can spend your API credits.
DASHBOARD_PASSWORD=
MAX_TOKENS=8192

# --- Web search (optional) ---
# Set automatically by setup-web-search.sh
SEARXNG_URL=

# --- Obsidian vault (notes + memory) ---
# Folder of Markdown notes Nexus HQ reads and writes. Open the same folder in Obsidian.
# Default: a NexusVault folder next to this nexus-hq folder (~/Documents/NexusVault). Set VAULT_DIR=off to turn notes off.
VAULT_DIR=

# --- Photos ---
# Where photos you attach or take are saved. Default: a NexusPhotos folder next to this nexus-hq folder (~/Documents/NexusPhotos).
PHOTOS_DIR=

# --- GitHub (optional) ---
# Fine-grained token: Contents + Pull requests = Read and write
GITHUB_TOKEN=
